//                                      █        █ █      ▄▀            ▀▄      █         █
//                                      █       █  █    ▄▀                ▀▄    █        █
//                                      █      █   █   █                    █   █       █
//                                      █     █    █   █                    █   █      █
//                                      █    █     █   █                    █   █  ▀▀▀█▀▀▀▀
//                                      █   █ █    █   █                    █   █    █
//                                      █  █   █   █   █                    █   █   █
//                                      █ █     █  █    ▀▄                ▄▀    █  █
//                                      ██       █ █      ▀▄            ▄▀      █ █
//                                      █         ██▄▄▄▄▄▄▄▄█▄▄▄▄▄▄▄▄▄▄▀        ██▄▄▄▄▄▄▄▄▄▄
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define ETC 4
#define FAST 5

// --- Mouse Settings (기존 유지) ---

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&mmv_input_listener {
    compatible = "zmk,input-listener";
    device = <&mmv>;

    fast {
        layers = <FAST>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&mt {
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
};

&lt {
    quick-tap-ms = <150>;
    tapping-term-ms = <150>;
};

/ {
    /* 1. LED 인디케이터 설정 추가 */

    led_indicators {
        compatible = "zmk,control-led-indicator";

        // BASE 레이어 (D3 LED)

        layer_base {
            led = <&led_d3>;
            usage = "layer-state";
            layers = <BASE>;
        };

        // NAV 레이어 (D4 LED)

        layer_nav {
            led = <&led_d4>;
            usage = "layer-state";
            layers = <NAV>;
        };

        // SYM 레이어 (D5 LED)

        layer_sym {
            led = <&led_d5>;
            usage = "layer-state";
            layers = <SYM>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <10 20>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        bs {
            bindings = <&kp GRAVE>;
            key-positions = <0 10>;
        };

        lbkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <8 9>;
        };

        rbkt {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
        };

        app {
            bindings = <&kp SQT>;
            key-positions = <19 29>;
        };

        bss {
            bindings = <&kp BACKSLASH>;
            key-positions = <9 19>;
        };
    };

    behaviors {
        lt_mt: long_tap_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LONG_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <210>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp Q           &kp W       &kp E      &kp R         &kp T        &kp Y        &kp U        &kp I        &kp O    &kp P
&lt_mt LCTRL A  &mt LALT S  &kp LCTRL  &mt LSHIFT F  &kp G        &kp H        &mt RSHFT J  &mt RCTRL K  &kp L    &kp SEMICOLON
&kp Z           &kp X       &kp C      &kp V         &kp B        &kp N        &kp M        &kp COMMA    &kp DOT  &kp FSLH
                                       &kp LGUI      &lt 1 SPACE  &lt 2 ENTER  &kp BSPC
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        nav_layer {
            label = "NAVI";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp N7  &kp N8  &kp N9     &kp N0
&trans        &trans        &trans        &trans        &trans  &trans        &trans  &trans  &kp MINUS  &kp EQUAL
&trans        &trans        &trans        &trans        &trans  &trans        &trans  &trans  &trans     &trans
                                          &trans        &trans  &trans        &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp LCTRL     &kp AMPS          &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans           &trans       &trans    &trans      &trans       &trans        &kp LC(UP_ARROW)  &trans         &trans                &trans
&trans           &trans       &trans    &trans      &trans       &kp LC(LEFT)  &kp LC(DOWN)      &kp LC(RIGHT)  &trans                &trans
                                        &trans      &trans       &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
            label = "ADJ";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &out OUT_TOG  &trans  &trans  &trans  &kp F7  &kp F8  &kp F9  &kp F12
&bt BT_CLR    &bt BT_NXT    &kp PSCRN     &trans  &trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11
&trans        &bt BT_PRV    &trans        &trans  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10
                                          &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        etc_layer {
            label = "ETC";
            bindings = <
&trans  &trans          &mmv MOVE_UP    &trans           &trans  &msc MOVE_DOWN  &mkp MB4  &mkp MB5  &trans  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans          &mo 5     &trans    &trans  &trans
&trans  &trans          &trans          &trans           &trans  &msc MOVE_UP    &trans    &mkp MB3  &trans  &trans
                                        &trans           &trans  &mkp MB1        &mkp MB2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fast_layer {
            label = "FAST";
            bindings = <
&trans  &trans          &mmv MOVE_UP    &trans           &trans  &msc MOVE_DOWN  &mkp MB4  &mkp MB5  &trans  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans          &trans    &trans    &trans  &trans
&trans  &trans          &trans          &trans           &trans  &msc MOVE_UP    &trans    &mkp MB3  &trans  &trans
                                        &trans           &trans  &mkp MB1        &mkp MB2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
